# Proposed server-side settings; no application consumes these yet.
# Copy to .env locally after scaffolding. Never expose the key in browser code.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash

# The implementation should populate a verified speaker for this language.
TEACHING_LANGUAGE=hi-IN
SARVAM_TTS_SPEAKER=

# Optional teammate-owned feature; preset teaching must not require it.
ENABLE_CUSTOM_VOICE=false
