# Server-side settings. Copy to .env locally. Never expose keys in browser code.
SARVAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3

# The implementation should populate a verified speaker for this language.
TEACHING_LANGUAGE=hi-IN
SARVAM_TTS_SPEAKER=shubh

# Optional teammate-owned feature; preset teaching must not require it.
ENABLE_CUSTOM_VOICE=false
